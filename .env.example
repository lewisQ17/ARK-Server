# --- Proxmox (any cluster node; the ARK VM lives on pve) ---
PVE_HOST=10.0.0.10
PVE_PORT=8006
PVE_NODE=pve
PVE_VMID=100
PVE_USER=root@pam
PVE_PASSWORD=              # from macOS Keychain: secret get proxmox/root-pw-old

# --- ARK instance (Extinction on the ARK VM) ---
ARK_SERVICE=ark-extinction
ARK_USER=arkadmin
ARK_MANAGER=/home/arkadmin/ark-manager/ark-manager.sh
ARK_RCON_PORT=27020
ARK_RCON_PASSWORD=         # AdminPassword from maps/Extinction/map.conf
ARK_MAX_PLAYERS=70
ARK_RAM_ALLOC=16

PORT=8787
POLL_INTERVAL_MS=6000
