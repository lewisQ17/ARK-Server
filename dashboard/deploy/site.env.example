# Site-specific deployment settings for deploy/deploy.sh.
#
#   cp deploy/site.env.example deploy/site.env    # then fill in your own values
#
# deploy/site.env is gitignored: it describes YOUR network, so it must never end
# up in the repository. Only non-secret addresses belong here — passwords and API
# keys are pulled from the macOS Keychain by deploy.sh at run time.

# --- Proxmox host that runs the ARK VM (required) ---
PVE_HOST=            # e.g. 10.0.0.10
PVE_PORT=8006
PVE_NODE=            # node name as shown in the PVE UI, e.g. pve
PVE_VMID=            # numeric VM id, e.g. 100
PVE_USER=root@pam
# Keychain entry holding the Proxmox password, read by deploy.sh via
# ~/.claude/bin/secret. Name it whatever your own store uses.
PVE_PW_KEY=proxmox/root-pw
# Keychain entry holding the UniFi API key (only needed when UNIFI_HOST is set).
UNIFI_KEY_KEY=unifi/api-key

# --- The ARK instance inside that VM (required: ARK_SERVICE) ---
ARK_SERVICE=ark-extinction
ARK_USER=arkadmin
ARK_MANAGER=/home/arkadmin/ark-manager/ark-manager.sh
ARK_RCON_PORT=27020
ARK_MAX_PLAYERS=70
ARK_RAM_ALLOC=16

# --- UniFi/UDM WAN port-forwarding (optional) ---
# Leave UNIFI_HOST and ARK_VM_IP empty to disable port-forward management.
# All three (key + host + VM ip) must be set before it activates.
UNIFI_HOST=          # e.g. 10.0.0.1
UNIFI_SITE=default
ARK_VM_IP=           # the ARK VM's reserved LAN ip, the forward target
UNIFI_FORWARD_PROTO=udp
