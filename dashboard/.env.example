# =============================================================================
#  Pick a mode
# =============================================================================
# local   — the game server runs on THIS machine; the dashboard calls the manager
#           directly. This is what install.sh from the ARK-Server repo sets up.
# proxmox — the game server lives in a Proxmox VM and everything goes over the
#           qemu-guest-agent. The original homelab setup.
# Leave empty to auto-detect: no PVE_PASSWORD means local.
ARK_EXEC_MODE=local

# --- Dashboard login (REQUIRED) ---------------------------------------------
# Without DASH_PASS every request is refused — the panel can start/stop worlds and
# read admin passwords, so it never runs unauthenticated.
DASH_USER=admin
DASH_PASS=

# Where to listen. 127.0.0.1 keeps it off the network (reach it over an SSH
# tunnel); 0.0.0.0 exposes it to your LAN.
# In Docker this must be 0.0.0.0 — the published port cannot reach a process
# bound to the container's loopback. deploy/deploy.sh sets that for you.
BIND=127.0.0.1
PORT=8787

# "Reboot the VM" means rebooting this machine in local mode. Off unless you say so.
ALLOW_HOST_POWER=0

# --- Proxmox (only for ARK_EXEC_MODE=proxmox) --------------------------------
# All four are required in proxmox mode — the app refuses to start without them
# rather than falling back to some address baked into the repo.
PVE_HOST=                  # your Proxmox host, e.g. 10.0.0.10
PVE_PORT=8006
PVE_NODE=                  # node name as shown in the PVE UI, e.g. pve
PVE_VMID=                  # numeric VM id of the ARK VM, e.g. 100
PVE_USER=root@pam
PVE_PASSWORD=              # keep it out of shell history; a password manager or
                           # `pass`/Keychain lookup in your deploy script is fine

# --- ARK instance ---
ARK_SERVICE=ark-extinction
ARK_USER=arkadmin
ARK_MANAGER=/home/arkadmin/ark-manager/ark-manager.sh
ARK_RCON_PORT=27020
ARK_RCON_PASSWORD=         # AdminPassword from maps/Extinction/map.conf
ARK_MAX_PLAYERS=70
ARK_RAM_ALLOC=16

PORT=8787
POLL_INTERVAL_MS=6000
